# my-pi-setup runtime values.
# Copied to ~/.pi/my-pi-setup/.env on first use (override with MY_PI_ENV_FILE).
# Edit with /my-pi-api-keys. Empty values count as unset; a non-empty shell
# variable of the same name takes precedence.

TAVILY_API_KEY=
EXA_API_KEY=
CONGRESS_GOV_API_KEY=
NTFY_BASE_URL=
NTFY_USER=
NTFY_PASSWORD=
